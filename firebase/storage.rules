rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /cinereel/{all=**} {
      allow read, write: if false;
    }
    match /users/{uid}/{kind}/{file} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && ((kind == 'audio' && request.resource.contentType.matches('audio/.*') && request.resource.size < 50 * 1024 * 1024)
         || (kind == 'images' && request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024)
         || (kind == 'videos' && request.resource.contentType.matches('video/.*') && request.resource.size < 200 * 1024 * 1024));
    }
  }
}
